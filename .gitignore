# =============================================================================
# ResumeDrop — Python-Only .gitignore
# =============================================================================

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg
.eggs/
.vite/

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
*.xml

# --- Generated output ---
output/*.xlsx
output/*.csv
eval_results/
!output/.gitkeep

# --- AI Studio & Editor artifacts ---
.aistudio/
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- OS-generated ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets and credentials ---
.env
*.env
!.env.example
secrets.json

# --- Logs ---
*.log
