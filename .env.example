# ==============================================================================
# NVIDIA NIM API Configuration
# ==============================================================================
# Obtain free NVIDIA API keys (starting with nvapi-) at https://build.nvidia.com/
# Sign in with your NVIDIA Developer account, select any model marked "Free Endpoint",
# and generate up to three API keys under your account.
#
# Primary Configuration: 3 API keys belonging to the same NVIDIA account
# The application automatically pools all 3 keys, distributes parallel requests
# across them, and enforces a shared concurrency-safe 40 RPM aggregate rate limit.
# ==============================================================================
NVIDIA_API_KEY_1=nvapi-your_first_key_here
NVIDIA_API_KEY_2=nvapi-your_second_key_here
NVIDIA_API_KEY_3=nvapi-your_third_key_here

# Optional: Comma-separated list alternative
# NVIDIA_API_KEYS=nvapi-key1, nvapi-key2, nvapi-key3

# Optional: Single primary key fallback
# NVIDIA_API_KEY=nvapi-your_key_here

# ==============================================================================
# AI Model Configuration
# ==============================================================================
# Selected Free Endpoint Model: Meta Llama 3.3 70B Instruct
# High reasoning accuracy, 128k context window, strict JSON schema output.
# Fallback choices:
#   - nvidia/llama-3.1-nemotron-70b-instruct
#   - deepseek-ai/deepseek-r1
#   - mistralai/mistral-large-2-instruct
DEFAULT_NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# NVIDIA NIM OpenAI-Compatible API Endpoint Base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ==============================================================================
# Rate Limiting & Concurrency Controls
# ==============================================================================
# Shared rate limit across all keys (maximum requests per rolling 60 seconds).
# Because all 3 keys belong to the same NVIDIA account, this global limit protects
# against account-wide throttling and retry storms.
NVIDIA_RATE_LIMIT_RPM=40

# Maximum concurrent background extraction threads
MAX_WORKERS=3

# Per-request HTTP timeout in seconds (default: 180).
# Complex resumes and deep reasoning models (e.g. Llama 3.3 70B, DeepSeek R1) require
# 120s to 300s to avoid 500/504 Request timed out errors.
REQUEST_TIMEOUT=180
NVIDIA_API_TIMEOUT=180