# Groq Cloud API Configuration
# Option 1: Single primary key
GROQ_API_KEY=

# Option 2: Comma-separated multi-key pool for parallel processing & rate-limit failover
GROQ_API_KEYS=

# Option 3: Numbered individual keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# AI Model Configuration
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b

# Concurrency & Performance
MAX_WORKERS=3
REQUEST_TIMEOUT=45